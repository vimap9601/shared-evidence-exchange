{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEEP Evidence Manifest",
  "type": "object",
  "required": [
    "protocol",
    "project_id",
    "generated_at",
    "root",
    "files"
  ],
  "properties": {
    "protocol": {
      "const": "SEEP-1.0"
    },
    "project_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "root": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "modified_at": {
            "type": "string"
          },
          "authority": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
