{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/seep/response.schema.json",
  "title": "SEEP Exchange Message",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "protocol",
    "project_id",
    "message_id",
    "in_reply_to",
    "sender",
    "recipient",
    "created_at",
    "message_type",
    "summary_markdown",
    "claims",
    "open_questions",
    "required_response"
  ],
  "properties": {
    "protocol": {
      "const": "SEEP-1.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "message_id": {
      "type": "string",
      "pattern": "^EXCHANGE-[0-9]{4}[A-Z]?$"
    },
    "in_reply_to": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^EXCHANGE-[0-9]{4}[A-Z]?$"
        }
      ]
    },
    "sender": {
      "type": "string",
      "minLength": 1
    },
    "recipient": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "message_type": {
      "enum": [
        "audit_challenge",
        "response",
        "rebuttal",
        "correction",
        "reconciliation",
        "escalation"
      ]
    },
    "summary_markdown": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/open_question"
      }
    },
    "required_response": {
      "type": "object"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "file",
        "authority"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": [
            "integer",
            "string"
          ]
        },
        "sheet": {
          "type": "string"
        },
        "section": {
          "type": "string"
        },
        "excerpt": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "claim_id",
        "statement",
        "position",
        "confidence",
        "materiality",
        "reasoning_summary",
        "sources"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "enum": [
            "supported",
            "rejected",
            "uncertain",
            "agree",
            "disagree",
            "partially_agree",
            "unresolved"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "materiality": {
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "reasoning_summary": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "counterevidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "open_question": {
      "type": "object",
      "required": [
        "question_id",
        "question",
        "evidence_needed"
      ],
      "properties": {
        "question_id": {
          "type": "string"
        },
        "question": {
          "type": "string"
        },
        "evidence_needed": {
          "type": "string"
        }
      }
    }
  }
}
